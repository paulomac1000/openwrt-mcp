{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Router Context Snapshot",
  "description": "Response schema for get_router_context tool. A unified snapshot of router state.",
  "type": "object",
  "properties": {
    "device_id": {
      "type": "string",
      "description": "Router hostname"
    },
    "model": {
      "type": "string",
      "description": "Router hardware model"
    },
    "uptime_seconds": {
      "type": "number",
      "description": "System uptime in seconds"
    },
    "memory_used_percent": {
      "type": "number",
      "description": "Percentage of used RAM"
    },
    "openwrt_version": {
      "type": "string",
      "description": "OpenWRT firmware version"
    },
    "kernel": {
      "type": "string",
      "description": "Linux kernel version"
    },
    "cpu_load_1min": {
      "type": "number",
      "description": "CPU load average (1 minute)"
    },
    "interfaces_count": {
      "type": "integer",
      "description": "Number of wireless interfaces"
    },
    "wifi_clients_total": {
      "type": "integer",
      "description": "Total WiFi clients connected"
    },
    "dhcp_leases_count": {
      "type": "integer",
      "description": "Number of active DHCP leases"
    },
    "connectivity_health": {
      "type": "string",
      "enum": ["excellent", "good", "poor", "unknown"],
      "description": "Overall connectivity health rating"
    },
    "internet_reachable": {
      "type": "boolean",
      "description": "Whether the internet is reachable"
    },
    "schema_version": {
      "type": "string",
      "description": "Schema version for forward compatibility"
    },
    "subsections": {
      "type": "object",
      "description": "Per-subsection success/error flags for graceful degradation",
      "patternProperties": {
        "^[a-z_]+$": {
          "type": "object",
          "properties": {
            "success": {"type": "boolean"},
            "error": {"type": ["string", "null"]}
          }
        }
      }
    }
  },
  "required": ["device_id", "schema_version", "subsections"]
}
