# OpenWRT-MCP Configuration
# Copy this file to .env and fill in your values

# Required
OPENWRT_HOST=192.168.1.1
OPENWRT_SSH_KEY=/app/keys/openwrt_id_ed25519

# Optional
OPENWRT_PORT=22
OPENWRT_USER=root
# OPENWRT_PASSWORD=          # Not recommended – use SSH keys

# Server ports
MCP_SSE_PORT=9095
REST_API_PORT=9096

# SSH settings
SSH_TIMEOUT=30

# Audit logging
ENABLE_AUDIT_LOGGING=true
AUDIT_LOG_FILE=/var/log/openwrt_mcp.log

# Docker deployment (REQUIRED for port forwarding)
# MCP_UNSAFE_PUBLIC_ACCESS_CONFIRMED=1  # Uncomment for Docker / docker-compose

# Write operations (disabled by default)
ENABLE_WRITE_OPERATIONS=false

# Server logging
LOG_LEVEL=INFO

# Codecov upload — get your token at https://app.codecov.io
CODECOV_TOKEN=your_codecov_token_here
