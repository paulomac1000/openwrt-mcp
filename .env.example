# Router identity and SSH authentication
OPENWRT_HOST=192.168.1.1
OPENWRT_PORT=22
OPENWRT_USER=root
OPENWRT_SSH_KEY=/app/keys/openwrt_id_ed25519
# OPENWRT_PASSWORD=

# Required outside mock mode. Generate with:
# ssh-keyscan -H 192.168.1.1 > keys/known_hosts
OPENWRT_KNOWN_HOSTS=/app/keys/known_hosts

# Development-only escape hatch. Never enable in production.
OPENWRT_INSECURE_SKIP_HOST_KEY_CHECK=false

# MCP profile
MCP_TRANSPORT=stdio

# Loopback health endpoint
HEALTH_PORT=9094
SSH_TIMEOUT=30

# Deterministic local mode; performs no network I/O.
OPENWRT_MOCK_MODE=false

# Audit and diagnostics
ENABLE_AUDIT_LOGGING=true
AUDIT_LOG_FILE=/app/log/openwrt_mcp.log
LOG_LEVEL=INFO
