# OpenWRT MCP configuration

# Router identity and SSH authentication
OPENWRT_HOST=192.168.1.1
OPENWRT_PORT=22
OPENWRT_USER=root
OPENWRT_SSH_KEY=/app/keys/openwrt_id_ed25519
# OPENWRT_PASSWORD=
# Recommended for every deployment; mandatory before future write activation.
# OPENWRT_KNOWN_HOSTS=/app/keys/known_hosts

# MCP hardened profile
MCP_TRANSPORT=stdio

# Optional loopback-only REST convenience adapter
ENABLE_REST_API=false
REST_API_PORT=9096
# MCP_REST_AUTH_TOKEN=replace-with-a-long-random-token
# MCP_ALLOWED_ORIGINS=http://127.0.0.1:3000
MCP_MAX_REQUEST_BODY_BYTES=65536

# Health and dependency behavior
HEALTH_PORT=9094
SSH_TIMEOUT=30

# Deterministic local mode; never enable in a real deployment.
OPENWRT_MOCK_MODE=false

# Audit and diagnostics
ENABLE_AUDIT_LOGGING=true
AUDIT_LOG_FILE=/app/log/openwrt_mcp.log
LOG_LEVEL=INFO
